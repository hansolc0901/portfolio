# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 서버가 사용할 포트 번호
PORT=4000

# 데이터를 어디서 읽을지 고릅니다.
#   json = data/portfolio.json 파일에서 읽음 (지금 상태)
#   db   = 데이터베이스에서 읽음 (backend/src/repositories/dbRepository.js 를 완성해야 동작)
DATA_SOURCE=json

# DATA_SOURCE=db 일 때 사용할 데이터베이스 주소입니다.
# 예시) postgresql://아이디:비밀번호@localhost:5432/portfolio
#      mysql://아이디:비밀번호@localhost:3306/portfolio
DATABASE_URL=

# 방문자용 API 를 다른 주소에서 부를 수 있게 허용할 목록입니다.
# 쉼표로 구분하고, * 는 전체 허용입니다. 인터넷에 공개할 때는 실제 주소만 적으세요.
# (관리자 주소에는 적용되지 않습니다. 관리자는 언제나 같은 주소에서만 부를 수 있습니다)
ALLOWED_ORIGINS=*

# ── 관리자 페이지 ────────────────────────────────────────────
# 관리자 비밀번호입니다. 직접 적지 말고 아래 명령으로 정하세요.
#   cd backend
#   npm run set-password -- 새비밀번호
# 비밀번호 원문이 아니라 되돌릴 수 없는 형태(해시)가 들어갑니다.
ADMIN_PASSWORD_HASH=

# 아무 동작도 하지 않고 이만큼(분) 지나면 서버에 남은 출입증이 저절로 없어집니다.
# 쓰는 동안에는 계속 미뤄지므로 작업 중에 끊기지 않습니다.
# (창을 닫으면 시간과 상관없이 바로 없어집니다)
SESSION_TTL_MINUTES=30

# '배포용 파일 다시 만들기' 버튼이 실행할 파이썬 명령입니다.
# python 으로 실행되지 않으면 python3 또는 전체 경로로 바꾸세요.
PYTHON_BIN=python
